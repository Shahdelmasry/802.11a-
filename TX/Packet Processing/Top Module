`timescale 1ns / 1ps


module pp_top #(
    parameter DATA_WIDTH = 16
)(
    input  wire                         clk,
    input  wire                         rst_n,

    // ==========================================
    // FSM Control Interfaces (From State Machine)
    // ==========================================
    input  wire [1:0]                   mux_sel,    // 00: Idle, 01: Preamble, 10: IFFT
    input  wire                         rom_rd_en,  // Enable reading from Preamble ROM
    input  wire [8:0]                   rom_addr,   // Address for Preamble ROM
    output wire                         rom_ready,  // Tells FSM if ROM is ready for next read

    // ==========================================
    // Baseband Data Interface (From IFFT + CP)
    // ==========================================
    input  wire signed [DATA_WIDTH-1:0] ifft_data_i,
    input  wire signed [DATA_WIDTH-1:0] ifft_data_q,
    input  wire                         ifft_valid,
    input  wire                         ifft_last,
    output wire                         ifft_ready, // Tells IFFT to pause/send data

    // ==========================================
    // Physical DAC Interfaces (To External FMC DAC)
    // ==========================================
    output wire                         dac_clk,    // Clock forwarded to DAC chip
    output wire        [DATA_WIDTH-1:0] dac_data_i, // Physical Pins (I Channel)
    output wire        [DATA_WIDTH-1:0] dac_data_q  // Physical Pins (Q Channel)
);

    // =========================================================
    // Internal Interconnect Wires
    // =========================================================
    
    // 1. ROM to MUX
    wire signed [DATA_WIDTH-1:0] rom_to_mux_i;
    wire signed [DATA_WIDTH-1:0] rom_to_mux_q;
    wire                         rom_to_mux_valid;
    wire                         rom_to_mux_last;
    wire                         mux_to_rom_ready;

    // 2. MUX to Upsampler
    wire signed [DATA_WIDTH-1:0] mux_to_up_i;
    wire signed [DATA_WIDTH-1:0] mux_to_up_q;
    wire                         mux_to_up_valid;
    wire                         mux_to_up_last;
    wire                         up_to_mux_ready;

    // 3. Upsampler to FIR Filter
    wire signed [DATA_WIDTH-1:0] up_to_fir_i;
    wire signed [DATA_WIDTH-1:0] up_to_fir_q;
    wire                         up_to_fir_valid;
    wire                         up_to_fir_last;
    wire                         fir_to_up_ready;

    // 4. FIR Filter to DAC Interface
    wire signed [DATA_WIDTH-1:0] fir_to_dac_i;
    wire signed [DATA_WIDTH-1:0] fir_to_dac_q;
    wire                         fir_to_dac_valid;
    wire                         fir_to_dac_last; 
    wire                         dac_to_fir_ready;

    // =========================================================
    // Instantiations
    // =========================================================

    preamble_rom #(
        .ADDR_WIDTH(9),
        .INTEGER_BITS(2),
        .FRACTIONAL_BITS(14),
        .ROM_FILE("preamble_rom_data.mem"), 
        .ROM_DEPTH(320)
    ) u_preamble_rom (
        .clk(clk),
        .rst_n(rst_n),
        .rd_en(rom_rd_en),
        .addr(rom_addr),
        .rd_ready(rom_ready),
        .i_out(rom_to_mux_i),
        .q_out(rom_to_mux_q),
        .valid(rom_to_mux_valid),
        .last(rom_to_mux_last),
        .out_ready(mux_to_rom_ready)
    );

    tx_mux #(
        .DATA_WIDTH(DATA_WIDTH)
    ) u_tx_mux (
        .sel(mux_sel),
        .preamble_i(rom_to_mux_i),
        .preamble_q(rom_to_mux_q),
        .preamble_valid(rom_to_mux_valid),
        .preamble_last(rom_to_mux_last),
        .preamble_ready(mux_to_rom_ready),
        .ifft_data_i(ifft_data_i),
        .ifft_data_q(ifft_data_q),
        .ifft_valid(ifft_valid),
        .ifft_last(ifft_last),
        .ifft_ready(ifft_ready),
        .mux_out_i(mux_to_up_i),
        .mux_out_q(mux_to_up_q),
        .mux_valid(mux_to_up_valid),
        .mux_last(mux_to_up_last),
        .mux_ready(up_to_mux_ready)
    );

    upsampler_zero_stuffing #(
        .DATA_WIDTH(DATA_WIDTH),
        .L(2)
    ) u_upsampler_zero (
        .clk(clk),
        .rst_n(rst_n),
        .in_i(mux_to_up_i),
        .in_q(mux_to_up_q),
        .in_valid(mux_to_up_valid),
        .in_last(mux_to_up_last),
        .in_ready(up_to_mux_ready),
        .out_i(up_to_fir_i),
        .out_q(up_to_fir_q),
        .out_valid(up_to_fir_valid),
        .out_last(up_to_fir_last),
        .out_ready(fir_to_up_ready)
    );

    upsampler_fir #(
        .DATA_WIDTH(DATA_WIDTH),
        .COEFF_WIDTH(16),
        .NUM_TAPS(7),
        .FRAC_BITS(14)
    ) u_upsampler_fir (
        .clk(clk),
        .rst_n(rst_n),
        .in_i(up_to_fir_i),
        .in_q(up_to_fir_q),
        .in_valid(up_to_fir_valid),
        .in_last(up_to_fir_last),
        .in_ready(fir_to_up_ready),
        .out_i(fir_to_dac_i),
        .out_q(fir_to_dac_q),
        .out_valid(fir_to_dac_valid),
        .out_last(fir_to_dac_last),
        .out_ready(dac_to_fir_ready)
    );

    dac #(
        .DATA_WIDTH(DATA_WIDTH)
    ) u_dac_interface (
        .clk(clk),
        .rst_n(rst_n),
        .filter_i(fir_to_dac_i),
        .filter_q(fir_to_dac_q),
        .filter_valid(fir_to_dac_valid),
        .filter_ready(dac_to_fir_ready),
        .dac_clk(dac_clk),
        .dac_data_i(dac_data_i),
        .dac_data_q(dac_data_q)
    );

endmodule
